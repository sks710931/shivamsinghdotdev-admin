{
  "name": "shivamsinghdotdev-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/copy-tinymce.mjs",
    "build": "next build",
    "prebuild": "node scripts/copy-tinymce.mjs",
    "start": "next start",
    "lint": "eslint",
    "db:check": "node --conditions=react-server --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-db.ts",
    "db:migrate": "node --conditions=react-server --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate.ts",
    "dev:local": "bash scripts/dev-local.sh",
    "db:local": "bash scripts/dev-local.sh --db-only",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@tinymce/tinymce-react": "^6.3.0",
    "lucide-react": "^1.52.0",
    "mssql": "^12.7.3",
    "next": "16.3.8",
    "prismjs": "^1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tinymce": "^8.9.2",
    "zeptomail": "^8.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22"
  }
}
