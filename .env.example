# Copy this file to .env and fill in local values.
# .env is gitignored. This example is safe to commit.
# Keep secrets server-only. Do not prefix them with NEXT_PUBLIC_.

# Use DATABASE_URL or the DB_* variables. DATABASE_URL wins when it is set.
#
# Local SQL Server:
# DATABASE_URL=Server=localhost,1433;Database=shivamsinghdotdev_admin;User Id=sa;Password=change-me;Encrypt=true;TrustServerCertificate=true
#
# Azure SQL:
# DATABASE_URL=Server=tcp:your-server.database.windows.net,1433;Initial Catalog=shivamsinghdotdev_admin;User ID=your-user;Password=change-me;Encrypt=true;TrustServerCertificate=false
DATABASE_URL=

# Used only when DATABASE_URL is empty.
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=shivamsinghdotdev_admin
DB_USER=
DB_PASSWORD=
# Azure SQL requires encryption and a trusted public certificate.
# Local SQL Server usually presents a self-signed certificate, so trust it only in local dev.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# First admin user. Used only when the AdminUser table is empty.
# ADMIN_PASSWORD must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public URL used inside invite links.
APP_URL=http://localhost:3000

# ZeptoMail. The token is the full Authorization value, including the Zoho-enczapikey prefix.
# The sender must be a verified address, for example noreply@shivamsingh.dev.
ZEPTOMAIL_URL=https://cpaas.zoho.in/v1.1/email
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_ADDRESS=noreply@shivamsingh.dev
ZEPTOMAIL_FROM_NAME=noreply
